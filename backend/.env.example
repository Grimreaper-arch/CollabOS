# Copy this file to .env and fill in real values. Only the first block is required;
# every other feature switches itself off (with a clear message in the app) until it's filled in.
PORT=5000

# MongoDB Atlas: Database > Connect > Drivers > copy the connection string.
# Replace <password> and add the database name (collabos) before the "?".
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/collabos?retryWrites=true&w=majority

# Long random string used to sign login tokens. Never commit the real one.
JWT_SECRET=change-me-to-a-long-random-string
# How long you stay signed in (the refresh cookie). Access tokens last 15 minutes.
JWT_EXPIRES_IN=7d

# URL of the React website (allowed by CORS, used in email links and Google redirects).
CLIENT_URL=http://localhost:5173

# ---- Email (verification codes, invitations, reminders, receipts) ----
# A Gmail address and an App Password (Google Account > Security > 2-Step Verification > App passwords).
# Without these, emails are printed in the server window instead of being sent.
EMAIL_USER=
EMAIL_PASS=

# ---- Payments: Razorpay TEST mode (dashboard.razorpay.com > Settings > API Keys, Test Mode) ----
# Without keys, billing runs in demo mode (a pretend payment screen, no money involved).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Only needed once the site is public and you add a webhook in the Razorpay dashboard.
RAZORPAY_WEBHOOK_SECRET=

# ---- Google sign-in + Google Calendar (console.cloud.google.com) ----
# OAuth client type "Web application", redirect URI: http://localhost:5173/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- AI assistant: Azure OpenAI from Microsoft Foundry ----
# AI_PROVIDER: azure (default), openai, or mock (demo answers without any AI service).
AI_PROVIDER=azure
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21

# ---- Meetings: optional TURN relay for people on very strict networks ----
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

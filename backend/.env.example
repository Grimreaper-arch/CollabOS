# Copy this file to .env and fill in real values.
PORT=5000

# MongoDB Atlas: Database > Connect > Drivers > copy the connection string.
# Replace <password> and add the database name (collabos) before the "?".
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/collabos?retryWrites=true&w=majority

# Long random string used to sign login tokens. Never commit the real one.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# URL of the React dev server (allowed by CORS).
CLIENT_URL=http://localhost:5173
